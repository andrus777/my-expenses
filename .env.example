# Copy to .env for local Docker Compose development.
APP_ENV=development
POSTGRES_DB=my_expenses
POSTGRES_USER=my_expenses
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://my_expenses:change-me-for-local-development@postgres:5432/my_expenses
REDIS_URL=redis://redis:6379/0
# Generate a long random value for every non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-value
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
